# Proxy config for the public testbed droplet. The bootstrap +
# update workflows substitute ${DOMAIN}, ${WILDCARD_ROOT}, ${ZONE},
# and ${PROXY_OWNER_EMAIL} via envsubst before scp'ing this file to
# /etc/samizdat/proxy.toml on the droplet.

data = "/var/lib/samizdat/proxy"
target_node = "http://localhost:4510"

https = true
owner = "${PROXY_OWNER_EMAIL}"

[dns]
zone = "${ZONE}"
wildcard_root = "${WILDCARD_ROOT}"
provider = "digitalocean"
